# ----------------------------------------------------
# Global .gitignore for PRM393 Multi-Lab Repository
# ----------------------------------------------------

# Flutter & Dart build artifacts & cache
**/build/
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# IDE & Editor files
**/.idea/
**/*.iml
**/*.iws
**/*.ipr
**/.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Android build artifacts
**/.gradle/
**/android/**/gradle-wrapper.jar
**/android/local.properties
**/android/GeneratedPluginRegistrant.java

# iOS / macOS build artifacts
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/Flutter/App.framework
**/ios/**/Flutter/Flutter.framework
**/ios/**/Flutter/Flutter.podspec
**/ios/**/Flutter/Generated.xcconfig
**/ios/**/Flutter/app.flx
**/ios/**/Flutter/app.zip
**/ios/**/Flutter/flutter_assets/
**/macos/**/Pods/
**/macos/**/.symlinks/
**/macos/**/Flutter/ephemeral/

# Exceptions to keep necessary config
!**/.gitignore
